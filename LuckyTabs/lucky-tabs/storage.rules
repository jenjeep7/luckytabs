rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Flare sheets - allow authenticated users to read/write their own, functions to read all
    match /flare-sheets/{allPaths=**} {
      allow read: if request.auth != null; // Allow any authenticated user to read
      allow write: if request.auth != null; // Allow authenticated users to upload
    }
    
    // Avatar uploads - users can only upload to their own folder
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true; // Allow public read for avatars
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Post media uploads - users can upload to their own folder, everyone can read
    match /posts/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId && request.auth.token.email_verified == true;
    }
    
    // General file uploads for authenticated users
    match /uploads/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Require email verification for all other paths
    match /{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.email_verified == true;
    }
  }
}
